# Leave everything empty to run in demo mode (scripted replies, browser storage).

# Supabase (free tier works) - run supabase-schema.sql first
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI: Ollama runs locally for free (ollama pull llama3.2:1b)
USE_OLLAMA=true
# Or Google Gemini (has a free tier) when USE_OLLAMA=false
GOOGLE_GEMINI_API_KEY=

# Force demo mode even if Supabase is configured
# NEXT_PUBLIC_DEMO_MODE=true
